    local function BuildAutoSellBasket()
        local inventory = GetPlayerInventory()
        if not inventory then
            return nil, 0, ""
        end
        if not OreIndexByName then
            return nil, 0, ""
        end

        local basket = {}
        local total = 0
        local parts = {}
        local hasSelection = false

        for oreName in pairs(OreIndexByName) do
            local have = tonumber(inventory[oreName]) or 0
            if have > 0 then
                local selected = AutoSellKeepSet[oreName]
                if selected then
                    hasSelection = true
                end
                local sellAmount = 0
                if selected then
                    sellAmount = have
                end
                if sellAmount and sellAmount > 0 then
                    basket[oreName] = sellAmount
                    total = total + sellAmount
                    table.insert(parts, string.format("%s x%d", tostring(oreName), sellAmount))
                end
            end
        end

        table.sort(parts)
        local detail = ""
        if #parts > 0 then
            if #parts > 6 then
                local shown = {}
                for i = 1, 6 do
                    table.insert(shown, parts[i])
                end
                detail = table.concat(shown, ", ") .. string.format(" (+%d more)", #parts - 6)
            else
                detail = table.concat(parts, ", ")
            end
        end

        if not hasSelection or total <= 0 then
            return nil, 0, ""
        end

        return basket, total, detail
    end

