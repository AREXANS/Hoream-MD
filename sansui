    local function stepMoveTo(hrp, targetPos, lookAtPos)
        if not hrp or typeof(targetPos) ~= "Vector3" then
            return
        end

        if StepMoveBusy then
            return
        end
        StepMoveBusy = true

        local ok, err = pcall(function()
            local POS_EPS = 1
            local FAR_THRESHOLD = 70
            local FAR_STEP = 70
            local FAR_WAIT = 1
            local NEAR_MAX_STEP = 9999
            local NEAR_WAIT = 0

            local current = hrp.Position
            local dirVec = targetPos - current
            local dist = dirVec.Magnitude
            if dist < POS_EPS then
                local lookPos = lookAtPos or (current + hrp.CFrame.LookVector)
                hrp.CFrame = CFrame.lookAt(current, lookPos)
                return
            end

            local dir = dirVec.Unit

            if dist > FAR_THRESHOLD then
                local remaining = dist
                while remaining > POS_EPS do
                    local stepDist = math.min(FAR_STEP, remaining)
                    current = current + dir * stepDist
                    remaining = remaining - stepDist

                    local lookPos = lookAtPos or (current + hrp.CFrame.LookVector)
                    hrp.CFrame = CFrame.lookAt(current, lookPos)

                    if remaining > POS_EPS then
                        task.wait(FAR_WAIT)
                    end
                end
            else
                local steps = math.max(1, math.ceil(dist / NEAR_MAX_STEP))
                local stepSize = dist / steps

                for _ = 1, steps do
                    current = current + dir * stepSize
                    local lookPos = lookAtPos or (current + hrp.CFrame.LookVector)
                    hrp.CFrame = CFrame.lookAt(current, lookPos)
                    task.wait(NEAR_WAIT)
                end
            end
        end)

        if not ok then
            warn("[ArexansTools][stepMoveTo] move failed:", err)
        end
        StepMoveBusy = false
    end

