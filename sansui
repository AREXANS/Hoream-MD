    local function GetRaceSnapshot()
        local data = GetPlayerData()
        if not data then
            return nil
        end

        local rawRace = data.Race
        local rawSpins = data.Spins

        if type(rawRace) == "table" then
            if type(rawRace.Name) == "string" then
                rawRace = rawRace.Name
            elseif type(rawRace[1]) == "string" then
                rawRace = rawRace[1]
            end
        end

        if type(rawSpins) == "table" then
            if type(rawSpins.Value) == "number" then
                rawSpins = rawSpins.Value
            elseif type(rawSpins[1]) == "number" then
                rawSpins = rawSpins[1]
            end
        end

        local raceKey = rawRace
        local spins = tonumber(rawSpins) or 0

        local raceInfo = nil
        if RaceData and type(RaceData.Races) == "table" and raceKey ~= nil then
            raceInfo = RaceData.Races[raceKey]
        end

        local raceName = "None"
        local rarityName = "Unknown"

        local mappedName = raceKey ~= nil and RaceKeyToName[raceKey] or nil
        if type(mappedName) == "string" and mappedName ~= "" then
            raceName = mappedName
        elseif type(raceKey) == "string" or type(raceKey) == "number" then
            raceName = tostring(raceKey)
        end

        if type(raceInfo) == "table" and type(raceInfo.Rarity) == "string" then
            rarityName = raceInfo.Rarity
        end

        return {
            key = raceKey,
            name = raceName,
            rarity = rarityName,
            spins = spins,
        }
    end

