    local function ServerHopToLowerPlayer(fromAuto)
        local placeId = game.PlaceId
        local currentJobId = game.JobId

        if not placeId or not currentJobId then
            SafeNotify({
                Name = "Server Hop",
                Description = "PlaceId or JobId not available.",
                Type = "Error",
            })
            return
        end

        local requestFunc
        if syn and syn.request then
            requestFunc = syn.request
        elseif http and http.request then
            requestFunc = http.request
        elseif http_request then
            requestFunc = http_request
        elseif fluxus and fluxus.request then
            requestFunc = fluxus.request
        elseif request then
            requestFunc = request
        end

        if not requestFunc then
            SafeNotify({
                Name = "Server Hop",
                Description = "No supported HTTP request function found in this executor.",
                Type = "Error",
            })
            return
        end

        local success, result = pcall(function()
            local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(placeId)
            local response = requestFunc({
                Url = url,
                Method = "GET",
            })
            if not response or not response.Body then
                return nil
            end
            return HttpService:JSONDecode(response.Body)
        end)

        if not success or type(result) ~= "table" or type(result.data) ~= "table" then
            warn("[ArexansTools][ServerHop] Failed to fetch server list:", result)
            SafeNotify({
                Name = "Server Hop",
                Description = "Failed to fetch server list via HTTP.",
                Type = "Warning",
            })
            return
        end

        local best = nil
        for _, srv in ipairs(result.data) do
            local id = srv.id
            local playing = srv.playing
            local maxPlayers = srv.maxPlayers
            if id ~= currentJobId and type(playing) == "number" and type(maxPlayers) == "number" and playing < maxPlayers then
                if not best or playing < best.playing then
                    best = srv
                end
            end
        end

        if not best then
            SafeNotify({
                Name = "Server Hop",
                Description = "No lower-population server found.",
                Type = "Info",
            })
            return
        end

        local playing = best.playing or 0
        local maxPlayers = best.maxPlayers or 0
        local desc
        if fromAuto then
            desc = string.format("Auto hopping to lower-player server (%d/%d players).", playing, maxPlayers)
        else
            desc = string.format("Hopping to lower-player server (%d/%d players).", playing, maxPlayers)
        end

        SafeNotify({
            Name = "Server Hop",
            Description = desc,
            Type = "Info",
        })

        TeleportService:TeleportToPlaceInstance(placeId, best.id, LocalPlayer)
    end

