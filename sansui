    local function DoAutoMine()
        if not ToolActivatedRF then
            return
        end

        if not Flags.MineAll and not Flags.MineTarget then
            return
        end

        if AutoPotionBusy or AutoPotionNeedsAttention then
            return
        end

        if os.clock() < AutoPotionMovementLockUntil then
            return
        end

        if Flags.AutoSellOres and ProximityForceDialogueRF then
            if not SellDialogueReady then
                local ok = EnsureSellDialogue()
                if not ok then
                    return
                end
            end

            if os.clock() < AutoSellMovementLockUntil then
                return
            end
        end

        if Flags.KillNearbyWhileMining then
            local guardStart = tick()
            while Flags.KillNearbyWhileMining do
                local mob, mobHRP, mobDist = findNearestMobByType(nil, 5)
                if not mob or not mobHRP or not mobDist or mobDist > 5 then
                    break
                end
                local humanoid = mob:FindFirstChildOfClass("Humanoid")
                if not humanoid or humanoid.Health <= 0 then
                    break
                end

                local _, hrp = getCharacter()
                if not hrp then
                    return
                end

                local mobPos = mobHRP.Position

                local backDir = -mobHRP.CFrame.LookVector
                if backDir.Magnitude < 0.1 then
                    local dir = mobPos - hrp.Position
                    if dir.Magnitude > 0 then
                        backDir = dir.Unit
                    else
                        backDir = Vector3.new(0, 0, -1)
                    end
                end

                local distance = 4
                local mobTarget = mobPos + backDir * distance
                mobTarget = Vector3.new(mobTarget.X, mobPos.Y, mobTarget.Z)

                stepMoveTo(hrp, mobTarget, mobPos)

                local okKill, errKill = pcall(function()
                    ToolActivatedRF:InvokeServer("Weapon")
                end)

                if not okKill then
                    warn("[ArexansTools][AutoMine][Guard] Weapon invoke failed:", errKill)
                end

                if humanoid.Health <= 0 then
                    break
                end

                if tick() - guardStart > 8 then
                    break
                end

                task.wait(0.2)
            end
        end

        local ore, dist = findNearestOreByName(Flags.MineTarget)
        if not ore and Flags.MineTarget then
            warn("[ArexansTools][AutoMine] No ore found for target", tostring(Flags.MineTarget), "- falling back to any ore")
            ore, dist = findNearestOreByName(nil)
        end
        if not ore then
            warn("[ArexansTools][AutoMine] No ores found in world this tick; skipping")
            return
        end

        local _, hrp = getCharacter()
        if not hrp then
            return
        end

        local orePos = getOrePosition(ore)
        if not orePos then
            return
        end

        local targetPos = getAttackPosition(orePos, hrp.Position)
        stepMoveTo(hrp, targetPos, orePos)

        local posAfter = hrp.Position
        local toOre = orePos - posAfter
        if toOre.Magnitude > 0 then
            local baseCf = CFrame.lookAt(posAfter, orePos)
            hrp.CFrame = baseCf * CFrame.Angles(0, 0, math.rad(90))
        end

        local ok, err = pcall(function()
            ToolActivatedRF:InvokeServer("Pickaxe")
        end)

        if not ok then
            warn("[ArexansTools][AutoMine] Invoke failed:", err)
            AutoPotionBusy = false
        end
    end

