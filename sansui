            local function CreateRGBSlider(y, c)
                local SFrame = Create("Frame", {
                    Parent = SliderContainer,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 8, 0, y),
                    Size = UDim2.new(1, -16, 0, 12)
                })
                local Bar = Create("Frame", {
                    Parent = SFrame,
                    BackgroundColor3 = Color3.fromRGB(30, 41, 59),
                    Position = UDim2.new(0, 0, 0.5, -1),
                    Size = UDim2.new(1, 0, 0, 2)
                })
                Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Bar})
                local Fill = Create("Frame", {
                    Parent = Bar,
                    BackgroundColor3 = (c=="R" and Color3.new(1,0,0)) or (c=="G" and Color3.new(0,1,0)) or Color3.new(0,0,1),
                    Size = UDim2.new(0, 0, 1, 0)
                })
                local Btn = Create("TextButton", {
                    Parent = SFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 1, 0),
                    Text = ""
                })
                return Btn, Fill
            end

            local RBtn, RFill = CreateRGBSlider(4, "R")
            local GBtn, GFill = CreateRGBSlider(20, "G")
            local BBtn, BFill = CreateRGBSlider(36, "B")

            local function UpdateVisuals()
                Preview.BackgroundColor3 = ColorVal
                RFill.Size = UDim2.new(ColorVal.R, 0, 1, 0)
                GFill.Size = UDim2.new(ColorVal.G, 0, 1, 0)
                BFill.Size = UDim2.new(ColorVal.B, 0, 1, 0)
            end
            UpdateVisuals()

            local function UpdateColor()
                Preview.BackgroundColor3 = ColorVal
                if Flag then Library.Flags[Flag] = ColorVal end
                Callback(ColorVal)
            end

            local function HandleSlide(input, comp)
                local bar = (comp=="R" and RBtn) or (comp=="G" and GBtn) or BBtn
                local pct = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                local r, g, b = ColorVal.R, ColorVal.G, ColorVal.B
                if comp == "R" then r = pct elseif comp == "G" then g = pct else b = pct end
                ColorVal = Color3.new(r,g,b)
                UpdateVisuals()
                UpdateColor()
            end

            local function BindSlide(btn, comp)
                local dragging = false
                btn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true HandleSlide(input, comp) end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then HandleSlide(input, comp) end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)
            end
            BindSlide(RBtn, "R"); BindSlide(GBtn, "G"); BindSlide(BBtn, "B")

            Preview.MouseButton1Click:Connect(function()
                Expanded = not Expanded
                if Expanded then
                    TweenService:Create(PickerFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, UIConfig.ElementHeight + 50)}):Play()
                else
                    TweenService:Create(PickerFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, UIConfig.ElementHeight)}):Play()
                end
            end)
        end

        
