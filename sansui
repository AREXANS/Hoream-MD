        Placeholder = "Enter code...",
        Callback = function(text)
            CurrentRedeemCode = text or ""
        end,
    })

    MiscTab:AddButton({
        Label = "Redeem Code",
        Callback = function()
            local code = (CurrentRedeemCode or ""):match("^%s*(.-)%s*$") or ""
            if code == "" then
                SafeNotify({
                    Name = "Redeem Code",
                    Description = "Please enter a code first.",
                    Type = "Info",
                })
                return
            end

            if not RedeemCodeRF then
                SafeNotify({
                    Name = "Redeem Code",
                    Description = "RedeemCode remote not found.",
                    Type = "Error",
                })
                return
            end

            local ok, result = pcall(function()
                return RedeemCodeRF:InvokeServer(code)
            end)

            if not ok then
                SafeNotify({
                    Name = "Redeem Code",
                    Description = "Invoke failed: " .. tostring(result),
                    Type = "Error",
                })
                return
            end

            local data = result
            if type(data) == "table" and data[1] and type(data[1]) == "table" and data[1].Success ~= nil then
                data = data[1]
            end

            local success = type(data) == "table" and data.Success
            local message = type(data) == "table" and (data.Message or "") or ""
            if success then
                SafeNotify({
                    Name = "Redeem Code",
                    Description = message ~= "" and message or ("Code '" .. code .. "' redeemed successfully."),
                    Type = "Success",
                })
            else
                SafeNotify({
                    Name = "Redeem Code",
                    Description = message ~= "" and message or ("Code '" .. code .. "' failed."),
                    Type = "Error",
                })
            end
        end,
    })

    MiscTab:AddToggle({
        Label = "Auto Redeem Code",
        Key = "auto_redeem_codes",
        Callback = function(value)
            if not value then
                return
            end

            if not RedeemCodeRF then
                SafeNotify({
                    Name = "Auto Redeem Code",
                    Description = "RedeemCode remote not found.",
                    Type = "Error",
                })
                return
            end

            for _, code in ipairs(KnownCodes) do
                local ok, result = pcall(function()
                    return RedeemCodeRF:InvokeServer(code)
                end)

                if not ok then
                    SafeNotify({
                        Name = "Auto Redeem Code",
                        Description = string.format("[%s] Invoke failed: %s", tostring(code), tostring(result)),
                        Type = "Error",
                    })
                else
                    local data = result
                    if type(data) == "table" and data[1] and type(data[1]) == "table" and data[1].Success ~= nil then
                        data = data[1]
                    end

                    local success = type(data) == "table" and data.Success
                    local message = type(data) == "table" and (data.Message or "") or ""

                    SafeNotify({
                        Name = "Auto Redeem Code",
                        Description = string.format("[%s] %s", tostring(code), message ~= "" and message or (success and "Success" or "Failed")),
                        Type = success and "Success" or "Error",
                    })
                end

                task.wait(0.2)
            end
        end,
    })

