            local SliderName = opts.Name or opts.Label
            local Min, Max = opts.Range[1], opts.Range[2]
            local Default = opts.CurrentValue or Min
            local Flag = opts.Flag or opts.Key
            local Callback = opts.Callback or function() end
            local Increment = opts.Increment or 1
            local Suffix = opts.Suffix or ""

            local Value = Default
            if Flag and Library.Flags[Flag] ~= nil then Value = Library.Flags[Flag] end

            local SliderFrame = Create("Frame", {
