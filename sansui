                    Description = "Race Reroll remote not found.",
                    Type = "Error",
                })
            end
            return false, { reason = "NoRemote" }
        end

        local snap = GetRaceSnapshot()
        if not snap then
            if not silent then
                SafeNotify({
                    Name = "Race Reroll",
                    Description = "Player data is not ready.",
                    Type = "Error",
                })
            end
            return false, { reason = "NoData" }
        end

        local beforeSpins = snap.spins or 0
        if beforeSpins <= 0 then
            if not silent and not silentNoSpins then
                SafeNotify({
                    Name = "Race Reroll",
                    Description = "No spins left.",
                    Type = "Error",
                })
            end
            return false, { reason = "NoSpins", before = snap }
        end

        local beforeKey = snap.key

        local ok, result = pcall(function()
            return RaceRerollRF:InvokeServer()
        end)

        if not ok then
            if not silent then
                SafeNotify({
                    Name = "Race Reroll",
                    Description = "Invoke failed: " .. tostring(result),
                    Type = "Error",
                })
            end
            return false, { reason = "InvokeError", error = result }
        end

        local afterSnap = snap
        local start = tick()
        while tick() - start < 6 do
            task.wait(0.2)
            local s = GetRaceSnapshot()
            if s then
                afterSnap = s
                if (s.spins or 0) ~= beforeSpins or s.key ~= beforeKey then
                    break
                end
            end
        end

        UpdateRaceUI()

        local used = math.max(0, beforeSpins - (afterSnap.spins or beforeSpins))

        return true, {
            before = snap,
            after = afterSnap,
            used = used,
        }
    end

    local function RunRaceAutoLimited(sessionId)
        local totalUsed = 0

        while RaceAutoLimited and RaceAutoSession == sessionId do
            local snap = GetRaceSnapshot()
            if not snap then
                break
            end

            local spins = snap.spins or 0
            if spins <= 0 then
                break
            end

            if RaceMaxSpins <= 0 then
                break
            end

            if totalUsed >= RaceMaxSpins then
                break
            end

            local ok, info = RaceRerollOnce({
                silent = true,
                silentNoSpins = true,
            })

            if not ok then
                break
            end

            local used = info.used or 0
            if used <= 0 then
                break
            end

            totalUsed = totalUsed + used

            if totalUsed >= RaceMaxSpins then
                break
            end

            task.wait(0.5)
        end

        RaceAutoLimited = false
        if AutoRerollLimitedToggle then
            AutoRerollLimitedToggle:Set(false)
        end

        local finalSnap = GetRaceSnapshot()
        local raceName = finalSnap and finalSnap.name or "Unknown"
        local rarity = finalSnap and finalSnap.rarity or "Unknown"
        local spins = finalSnap and finalSnap.spins or 0

        SafeNotify({
            Name = "Race Auto Reroll",
            Description = string.format("Stopped. Used %d spins. Current race: %s (%s), Spins left: %d.", totalUsed, tostring(raceName), tostring(rarity), spins),
            Type = "Info",
        })
    end

    local function RunRaceAutoFull(sessionId)
        local totalUsed = 0
        local loops = 0

        while RaceAutoFull and RaceAutoSession == sessionId do
            local snap = GetRaceSnapshot()
            if not snap then
                break
            end

            local spins = snap.spins or 0
            if spins <= 0 then
                break
            end

            if IsTargetRace(snap.key) then
                break
            end

            local ok, info = RaceRerollOnce({
                silent = true,
                silentNoSpins = true,
            })

            if not ok then
                break
            end

            local used = info.used or 0
            if used <= 0 then
                break
            end

            totalUsed = totalUsed + used
            loops = loops + 1

            local afterSnap = info.after or GetRaceSnapshot()
            if afterSnap and IsTargetRace(afterSnap.key) then
                break
            end

            if loops >= 1000 then
                break
            end

            task.wait(0.5)
        end

        RaceAutoFull = false
