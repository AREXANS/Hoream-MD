    local function getOrePosition(ore)
        if ore:IsA("Model") then
            local bestPart
            local okScan = pcall(function()
                for _, d in ipairs(ore:GetDescendants()) do
                    if d:IsA("BasePart") then
                        if not bestPart or d.Size.Magnitude > bestPart.Size.Magnitude then
                            bestPart = d
                        end
                    end
                end
            end)
            if okScan and bestPart then
                return bestPart.Position
            end
            if ore.PrimaryPart then
                return ore.PrimaryPart.Position
            end
            local ok, cf = pcall(function()
                return ore:GetPivot()
            end)
            if ok and cf then
                return cf.Position
            end
        elseif ore:IsA("BasePart") then
            return ore.Position
        end
        return nil
    end

    local function isOreDepleted(ore)
        local ok, descendants = pcall(function()
            return ore:GetDescendants()
        end)
        if not ok or not descendants then
            return false
        end

        for _, d in ipairs(descendants) do
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                local text = string.lower(d.Text or "")
                if string.find(text, "hp", 1, true) then
                    local numStr = string.match(text, "([%d%.]+)")
                    local hpValue = numStr and tonumber(numStr) or nil
                    if hpValue ~= nil and hpValue <= 0.1 then
                        return true
                    end
                end
            end
        end

        return false
    end

