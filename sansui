    local function findNearestOreByName(name, maxDistance)
        local root = getOreRoot()
        if not root then
            return nil
        end

        local _, hrp = getCharacter()
        if not hrp then
            return nil
        end

        if maxDistance == nil then
            maxDistance = math.huge
        end

        local closest
        local bestDist = maxDistance

        local function scan(folder)
            for _, obj in ipairs(folder:GetChildren()) do
                if obj:IsA("Folder") then
                    scan(obj)
                elseif obj:IsA("BasePart") and obj.Name == "SpawnLocation" then
                    scan(obj)
                elseif obj:IsA("BasePart") or obj:IsA("Model") then
                    local displayName = getOreDisplayName(obj)
                    if (Flags.MineAll or not name or displayName == name) and not isOreDepleted(obj) then
                        local pos = getOrePosition(obj)
                        if pos then
                            local d = (pos - hrp.Position).Magnitude
                            if d < bestDist then
                                bestDist = d
                                closest = obj
                            end
                        end
                    end
                end
            end
        end

        scan(root)
        return closest, bestDist
    end

