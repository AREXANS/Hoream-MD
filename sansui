                local inv = GetPlayerInventory()
                if inv then
                    local ok, err = pcall(function()
                        AutoPotionNeedsAttention = false

                        -- First pass: decide which potions should be bought this tick and compute total gold required
                        local buyPlan = {}
                        local totalNeedGold = 0
                        local sharedGold = GetPlayerGold()

                        for _, id in ipairs(PotionIdList) do
                            local count = GetPotionCountFromInventory(inv, id)

                            local wantsBuy = AutoPotionBuyEnabled and AutoPotionBuySet[id] or false
                            local wantsUse = AutoPotionUseEnabled and AutoPotionUseSet[id] or false

                            -- ตัดสินใจว่าจะไปซื้อรอบนี้ไหม
                            local shouldBuyNow = false
                            if wantsBuy and count <= 0 then
                                if wantsUse then
                                    -- ถ้าเปิด Auto-Use: รอให้บัพหมด/ใกล้หมดก่อนค่อยไปซื้อ
                                    local remaining = GetPotionDurationSeconds(id)
                                    if not remaining or remaining <= 1 then
                                        shouldBuyNow = true
                                    end
                                else
                                    -- ไม่ได้เปิด Auto-Use: แค่จำนวนขวด = 0 ก็พอให้ไปซื้อได้เลย
                                    shouldBuyNow = true
                                end
                            end

                            local batch = AutoPotionBuyBatch
                            if not batch or batch <= 0 then
                                batch = 1
                            end

                            buyPlan[id] = {
                                count = count,
                                wantsUse = wantsUse,
                                shouldBuyNow = shouldBuyNow,
                                batch = batch,
                            }

                            if shouldBuyNow and sharedGold then
                                local knownCost = PotionGoldCost[id]
                                if knownCost then
                                    totalNeedGold = totalNeedGold + knownCost * batch
                                end
                            end

                            -- ช่วง Auto-Use ปกติ (ใช้ซ้ำเมื่อบัพจะหมดหรือครบคูลดาวน์)
                            if AutoPotionUseEnabled and AutoPotionUseSet[id] and count > 0 then
                                local last = AutoPotionLastUse[id] or 0
                                local now = tick()

                                local remaining = GetPotionDurationSeconds(id)

                                -- First-time use: if we never used this potion via Auto Potion
                                -- and there's no active buff (or it's about to expire), use it immediately.
                                if last <= 0 then
                                    if not remaining or remaining <= 1 then
                                        UsePotion(id, { silent = true })
                                        AutoPotionLastUse[id] = now
                                    end
                                else
                                    if remaining then
                                        if remaining <= 1 and (now - last) >= 1 then
                                            UsePotion(id, { silent = true })
                                            AutoPotionLastUse[id] = now
                                        end
                                    else
                                        local cd = PotionUseCooldowns[id] or 60
                                        if now - last >= cd then
                                            UsePotion(id, { silent = true })
                                            AutoPotionLastUse[id] = now
                                        end
                                    end
                                end
                            end
                        end

                        local allowBuys = true
                        if sharedGold and totalNeedGold > 0 then
                            if sharedGold < totalNeedGold then
                                allowBuys = false
                            end
                        end

                        -- Second pass: perform buys for potions that shouldBuyNow, but only if we have enough gold for all of them
                        local buySequence = {}
                        if allowBuys then
                            for _, id in ipairs(PotionIdList) do
                                local plan = buyPlan[id]
                                if plan and plan.shouldBuyNow then
                                    local batch = plan.batch
                                    local canBuy = true
                                    local gold = sharedGold or GetPlayerGold()
                                    if gold then
                                        local knownCost = PotionGoldCost[id]
                                        if knownCost then
                                            local needGold = knownCost * batch
                                            if gold < needGold then
                                                canBuy = false
                                            end
                                        end
                                    end

                                    if canBuy then
                                        table.insert(buySequence, {
                                            id = id,
                                            wantsUse = plan.wantsUse,
                                            batch = plan.batch,
                                            count = plan.count,
                                        })
                                    end
                                end
                            end
                        end

                        if #buySequence > 0 then
                            local originCFrame = nil
                            do
                                local _, hrp = getCharacter()
                                if hrp then
                                    originCFrame = hrp.CFrame
                                end
                            end

                            AutoPotionBusy = true
                            AutoPotionNeedsAttention = true

                            for _, entry in ipairs(buySequence) do
                                local id = entry.id
                                local wantsUse = entry.wantsUse
                                local batch = entry.batch
                                local count = entry.count

                                -- เดินไปที่ขวดของ potion ปัจจุบัน
                                local okTeleport = TeleportToPotionObject(id)
                                if okTeleport then
                                    AutoPotionMovementLockUntil = os.clock() + 3
                                    task.wait(0.5)
                                    inv = GetPlayerInventory() or inv
                                    count = GetPotionCountFromInventory(inv, id)
                                else
                                    warn("[ArexansTools][AutoPotion] TeleportToPotionObject failed for", id)
                                end

                                -- ถ้ายังไม่มีขวดในกระเป๋าจริง ๆ ให้ลองกดซื้อจนได้จำนวนที่ต้องการ (batch)
                                if count < batch then
                                    local goldBefore = GetPlayerGold()
                                    if goldBefore then
                                        AutoPotionLastGold[id] = goldBefore
                                    end

                                    -- ยิง Remote ซื้อทีละ 1 ขวด แล้วเช็คจำนวนในกระเป๋าซ้ำ
                                    -- เพื่อให้แน่ใจว่าถึงจำนวนที่ต้องการก่อนกลับไปขุด
                                    local safetyAttempts = 0
                                    local maxAttempts = batch * 2
                                    if maxAttempts < 4 then
                                        maxAttempts = 4
                                    end

                                    while count < batch and safetyAttempts < maxAttempts do
                                        PurchasePotion(id, 1, { silent = true })
                                        safetyAttempts += 1
                                        task.wait(0.15)
                                        inv = GetPlayerInventory() or inv
                                        count = GetPotionCountFromInventory(inv, id)
                                    end

                                    local goldAfter = GetPlayerGold()

                                    if goldBefore and goldAfter then
                                        local delta = goldBefore - goldAfter
                                        if delta > 0 then
                                            local costPer = delta / math.max(1, batch)
                                            PotionGoldCost[id] = costPer
                                        else
                                            warn("[ArexansTools][AutoPotion] Purchase for", id, "did not reduce gold (before=", goldBefore, "after=", goldAfter, ")")
                                        end
                                    end
                                end

                                -- ถ้าเปิด Auto-Use และมีขวดแล้ว ให้กินเลยหนึ่งครั้ง
                                if wantsUse and count > 0 then
                                    local nowUse = tick()
                                    UsePotion(id, { silent = true })
                                    AutoPotionLastUse[id] = nowUse
                                end
                            end

                            if originCFrame then
                                local _, hrpAfter = getCharacter()
                                local hrpToUse = hrpAfter
                                if hrpToUse and hrpToUse.Parent then
                                    local originPos = originCFrame.Position
                                    local lookPos = originPos + originCFrame.LookVector
                                    stepMoveTo(hrpToUse, originPos, lookPos)
                                end
                            end

                            AutoPotionMovementLockUntil = os.clock() + 3
                            AutoPotionNeedsAttention = false
                            AutoPotionBusy = false
                        end
                    end)

                    if not ok then
                        warn("[ArexansTools][AutoPotion] Loop error:", err)
                    end
                else
                    warn("[ArexansTools][AutoPotion] GetPlayerInventory() returned nil; skipping auto potion tick")
                end
            end
        end
    end)

