    local function AutoFillBestOres()
        local function notify(desc, typeStr)
            SafeNotify({
                Name = "Forge Helper",
                Description = desc,
                Type = typeStr or "Info",
            })
        end

        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then
            notify("PlayerGui not found.", "Error")
            return
        end

        local forgeGui = playerGui:FindFirstChild("Forge")
        if not forgeGui or not forgeGui.Enabled then
            notify("Open the Forge UI (Select Ores) before using this.", "Info")
            return
        end

        local oreSelect = forgeGui:FindFirstChild("OreSelect")
        if not (oreSelect and oreSelect.Visible) then
            notify("Please open the 'Select Ores' screen first.", "Info")
            return
        end

        local controllers = ReplicatedStorage:FindFirstChild("Controllers")
        if not controllers then
            notify("Controllers folder not found.", "Error")
            return
        end
        local uiFolder = controllers:FindFirstChild("UIController")
        if not uiFolder then
            notify("UIController not found.", "Error")
            return
        end
        local forgeModuleScript = uiFolder:FindFirstChild("Forge")
        if not forgeModuleScript then
            notify("Forge UI module not found.", "Error")
            return
        end

        local okModule, forgeModule = pcall(require, forgeModuleScript)
        if not okModule or type(forgeModule) ~= "table" then
            notify("Failed to load Forge UI module.", "Error")
            return
        end

        if type(forgeModule.AddOre) ~= "function" or type(forgeModule.RemoveOre) ~= "function" then
            notify("Forge module AddOre/RemoveOre not available.", "Error")
            return
        end

        if not OreData or not OreIndexByName then
            notify("Ore data not available.", "Error")
            return
        end

        local inventory = GetPlayerInventory()
        if not inventory then
            notify("Failed to read player inventory.", "Error")
            return
        end

        local function getTotalLumps()
            local t = 0
            local added = forgeModule.addedOres or {}
            for _, count in pairs(added) do
                if type(count) == "number" then
                    t = t + count
                end
            end
            return t
        end

        local function getLumpsFor(name)
            local added = forgeModule.addedOres or {}
            local v = added[name]
            if type(v) == "number" then
                return v
            end
            return 0
        end

        -- clear existing ores
        local current = forgeModule.addedOres or {}
        for oreName, count in pairs(current) do
            local n = tonumber(count) or 0
            for _ = 1, n do
                pcall(function()
                    forgeModule:RemoveOre(oreName)
                end)
            end
        end

        -- build candidate list from ores we actually own, sorted by Multiplier descending
        local candidates = {}
        for oreName, idx in pairs(OreIndexByName) do
            local oreInfo = OreData[idx]
            local mult = oreInfo and oreInfo.Multiplier or 0
            local have = tonumber(inventory[oreName]) or 0
            if mult > 0 and have > 0 then
                table.insert(candidates, {
                    Name = oreName,
                    Score = mult,
                    Have = have,
                })
            end
        end

        table.sort(candidates, function(a, b)
            return (a.Score or 0) > (b.Score or 0)
        end)

        local targetTotal = 10
        local addedAny = false

        for _, cand in ipairs(candidates) do
            while getTotalLumps() < targetTotal do
                if getLumpsFor(cand.Name) >= cand.Have then
                    break
                end

                local before = getTotalLumps()
                local okAdd = pcall(function()
                    forgeModule:AddOre(cand.Name)
                end)
                local after = getTotalLumps()
                if not okAdd or after <= before then
                    break
                end
                addedAny = true
            end
            if getTotalLumps() >= targetTotal then
                break
            end
        end

        local finalTotal = getTotalLumps()
        if not addedAny or finalTotal <= 0 then
            notify("No ores could be added. Check your inventory.", "Error")
        else
            notify(string.format("Applied best-guess ore mix (%d lumps). Review, then press FORGE manually.", finalTotal), "Success")
        end

        RefreshForgePreview()
    end

