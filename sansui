            local Knit = require(knitModule)
            if not Knit or type(Knit.GetController) ~= "function" then
                return nil
            end
            local playerController = Knit.GetController("PlayerController")
            if not playerController or not playerController.Replica then
                return nil
            end
            local data = playerController.Replica.Data
            if not data or type(data.Inventory) ~= "table" then
                return nil
            end
            return data.Inventory
        end)

