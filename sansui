    local function GetPotionCountFromInventory(inv, potionId)
        if not inv or not potionId then
            return 0
        end

        local total = 0

        local direct = inv[potionId]
        if type(direct) == "number" then
            total = total + direct
        elseif type(direct) == "table" then
            local n = direct.Quantity or direct.Count or direct[1]
            if type(n) == "number" then
                total = total + n
            end
        end

        local misc = inv.Misc
        if type(misc) == "table" then
            for _, item in pairs(misc) do
                if type(item) == "table" then
                    local name = item.Name or item.Id or item[1]
                    if name == potionId then
                        local n = item.Quantity or item.Count or item[2] or 1
                        total = total + (tonumber(n) or 0)
                    end
                end
            end
        end

        return total
    end

